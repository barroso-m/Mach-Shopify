# Variables del proyecto. Copiar como .env (que NO se versiona): cp .env.example .env
#
# Los valores son los del ambiente de staging en modo Pruebas, tomados del
# handoff de QA en Confluence ("Mach Shopify - Handoff QA"). Son credenciales
# de testing provistas por Mach para QA.
#
# La sesión iniciada de cada persona (cookies del admin de Shopify) NO va acá:
# se genera con `npm run auth:save` y queda en playwright/.auth/session.json.

# --- Shopify (tienda de staging mach-stage) ---
COMMERCE_SHOPIFY_LOGIN_URL=https://admin.shopify.com/store/mach-stage
COMMERCE_SHOPIFY_ORDERS_URL=https://admin.shopify.com/store/mach-stage/orders
COMMERCE_SHOPIFY_APPS_URL=https://admin.shopify.com/store/mach-stage/settings/apps
COMMERCE_SHOPIFY_PAYMENTS_SETTINGS_URL=https://admin.shopify.com/store/mach-stage/settings/payments
COMMERCE_SHOPIFY_CHECKOUT_URL=https://mach-stage.myshopify.com/
COMMERCE_DEV_DASHBOARD_URL=https://dev.shopify.com/dashboard/130907500/apps/269029867521
# Pantalla de onboarding de la app (se llega desde la instalación en el Dev Dashboard).
COMMERCE_ONBOARDING_URL=

# --- Panel Mach staging (switch en "Pruebas") ---
COMMERCE_PANEL_MACH_LOGIN_URL=https://pay-staging.somosmach.com/auth/sign-in
COMMERCE_PANEL_MACH_TRANSACCIONES_URL=https://pay-staging.somosmach.com/payments
COMMERCE_PANEL_MACH_USERNAME=valentina.kahl+pruebashopify1@bci.cl
